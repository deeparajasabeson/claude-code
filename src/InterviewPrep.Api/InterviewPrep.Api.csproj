<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ClientAppDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../interview-prep-web'))</ClientAppDir>
    <!-- Set to false (e.g. in CI) when the React app has already been built separately. -->
    <BuildClientApp Condition="'$(BuildClientApp)' == ''">true</BuildClientApp>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data/questions.json" LogicalName="InterviewPrep.Api.Data.questions.json" />
    <Content Remove="Data/questions.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InterviewPrep.Api.Tests" />
  </ItemGroup>

  <!-- On publish, build the React book UI and ship it in wwwroot so one App Service hosts API + SPA. -->
  <Target Name="PublishClientApp" AfterTargets="ComputeFilesToPublish" Condition="'$(BuildClientApp)' == 'true'">
    <Exec WorkingDirectory="$(ClientAppDir)" Command="npm ci" />
    <Exec WorkingDirectory="$(ClientAppDir)" Command="npm run build" />
    <ItemGroup>
      <ClientDistFiles Include="$(ClientAppDir)/dist/**" />
      <ResolvedFileToPublish Include="@(ClientDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot/%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
